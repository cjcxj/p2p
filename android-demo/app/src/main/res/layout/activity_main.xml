<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 上半部分：配置、状态、消息输入，小屏可滚动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/server_label" />

            <EditText
                android:id="@+id/serverInput"
                style="@style/FieldInput"
                android:hint="@string/server_hint" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/room_label" />

            <EditText
                android:id="@+id/roomInput"
                style="@style/FieldInput"
                android:hint="@string/room_hint" />

            <Button
                android:id="@+id/advToggle"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/advanced_collapse"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/advPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/auth_label" />

                <EditText
                    android:id="@+id/tokenInput"
                    style="@style/FieldInput"
                    android:hint="@string/token_hint" />

                <EditText
                    android:id="@+id/userInput"
                    style="@style/FieldInput"
                    android:hint="@string/user_hint" />

                <EditText
                    android:id="@+id/secretInput"
                    style="@style/FieldInput"
                    android:hint="@string/secret_hint"
                    android:inputType="textPassword" />

                <CheckBox
                    android:id="@+id/relayCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/relay_enabled" />

                <CheckBox
                    android:id="@+id/debugCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_log" />

                <CheckBox
                    android:id="@+id/plaintextCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plaintext_log" />

                <CheckBox
                    android:id="@+id/localStackCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/local_stack" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectBtn"
                    style="@style/WeightButton"
                    android:text="@string/connect" />

                <Button
                    android:id="@+id/disconnectBtn"
                    style="@style/WeightButton"
                    android:enabled="false"
                    android:text="@string/disconnect" />

                <Button
                    android:id="@+id/vpnBtn"
                    style="@style/WeightButton"
                    android:text="@string/vpn_on" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/status_disconnected"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memberText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp" />

            <TextView
                style="@style/FieldLabel"
                android:text="@string/message_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/peerInput"
                    style="@style/WeightInput"
                    android:hint="@string/peer_ip_hint" />

                <Button
                    android:id="@+id/pingBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/self_ping" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/msgInput"
                    style="@style/WeightInput"
                    android:hint="@string/message_hint" />

                <Button
                    android:id="@+id/sendBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/send" />

                <Button
                    android:id="@+id/broadcastBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/broadcast" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 下半部分：固定高度的日志区，独立滚动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearLogBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_log"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>

[Unit]
Description=p2p all-in-one server (signaling + STUN + relay)
After=network.target

[Service]
Type=simple
# Adjust ExecStart to your public IP / port / TLS options.
ExecStart=/usr/local/bin/p2p-server --public 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Optional hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

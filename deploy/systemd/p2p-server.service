[Unit]
Description=p2p single signaling + STUN server (pure P2P)
After=network.target

[Service]
Type=simple
# Adjust ExecStart to your port / multi-STUN / TLS options.
ExecStart=/usr/local/bin/p2p-server --port 8080
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Optional hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
